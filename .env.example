# Environment Example File
# Copy this file to .env.development, .env.production, .env.staging and fill in actual values

# Environment identifier
ENV = 'development'

# API configuration
VUE_APP_BASE_API = '/api'
VUE_APP_BACKEND_API_URL = 'http://localhost:8002'

# SSO authentication configuration
VUE_APP_SSO_AUTH_CENTER_URL = 'http://localhost:8010'
VUE_APP_SSO_PROJECT_CODE = 'FMMT'
VUE_APP_SSO_API_PREFIX = '/api/v1'
VUE_APP_SSO_CURRENT_DOMAIN = 'http://localhost:9528'

# Third-party service API keys
VUE_APP_GOOGLE_MAPS_API_KEY = 'your-google-maps-api-key-here'

# Feature toggles
VUE_APP_ENABLE_SSO_DIRECT_LOGIN = true
VUE_APP_USE_MOCK_DATA = true